{
  "name": "doc-assistant",
  "private": true,
  "version": "0.1.14",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node electron/dev.cjs",
    "typecheck": "tsc --noEmit",
    "electron:dev": "node electron/dev.cjs",
    "electron:preview": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:mac": "vite build && electron-builder --mac",
    "electron:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@tiptap/core": "3.27.1",
    "@tiptap/extension-code-block": "^3.27.1",
    "@tiptap/extension-color": "3.27.1",
    "@tiptap/extension-font-family": "3.27.1",
    "@tiptap/extension-highlight": "3.27.1",
    "@tiptap/extension-image": "3.27.1",
    "@tiptap/extension-link": "3.27.1",
    "@tiptap/extension-placeholder": "3.27.1",
    "@tiptap/extension-table": "3.27.1",
    "@tiptap/extension-table-cell": "3.27.1",
    "@tiptap/extension-table-header": "3.27.1",
    "@tiptap/extension-table-row": "3.27.1",
    "@tiptap/extension-task-item": "3.27.1",
    "@tiptap/extension-task-list": "3.27.1",
    "@tiptap/extension-text-align": "3.27.1",
    "@tiptap/extension-text-style": "3.27.1",
    "@tiptap/extension-underline": "3.27.1",
    "@tiptap/react": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "html-to-docx": "^1.8.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.6",
    "mermaid": "^11.16.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@unocss/vite": "^66.7.5",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "less": "^4.9.0",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "6.3.5"
  },
  "build": {
    "appId": "com.doc-assistant.app",
    "productName": "文档助手",
    "artifactName": "DocAssistant-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "安装包"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "mdoc",
        "name": "文档助手文档",
        "description": "文档助手文档文件"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "wenlong301-hue",
        "repo": "document-assistant"
      }
    ]
  }
}
