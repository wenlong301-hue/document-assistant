# 对外 API 端口（Nginx 反代到这里）
PORT=8080
# 协同 WebSocket 端口（Nginx 反代 /collab 到这里）
COLLAB_PORT=1234
HOST=0.0.0.0
# 数据目录（SQLite + 密钥）
DATA_DIR=./data
# 生产环境必须显式设置，否则每次重启会让所有登录态失效
JWT_SECRET=
# 客户端拿到的协同地址；部署在 HTTPS 域名后务必设置，否则客户端会连到 ws://host:1234
# PUBLIC_COLLAB_URL=wss://doc.example.com/collab
# 令牌有效期（秒）
ACCESS_TTL=1800
REFRESH_TTL=2592000
TICKET_TTL=43200
